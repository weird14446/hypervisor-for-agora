# Local hypervisor downloads, firmware, disks and generated cloud-init data.
# Keep AGORA_STATE_DIR under .local/ or outside this repository.
.local/
/.cache/
/.state/
/state/
/data/
/run/
/tmp/
/logs/
/downloads/
/images/
/firmware/
/rootfs/
/canvases/
/snapshots/
/artifacts/

# Environment settings and credentials; sanitized templates may be committed.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
.envrc
.envrc.*
!.envrc.example
secrets/
.secrets/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
/config/local/
/config/*.local
/config/*.local.*

# Generated cloud-init files can contain SSH keys and host-specific settings.
user-data
user-data.yaml
user-data.yml
user-data.json
meta-data
meta-data.yaml
meta-data.yml
network-config
vendor-data

