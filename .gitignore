# Runtime sockets, process IDs, logs and crash dumps.
# Do not ignore *.socket: systemd/*.socket files are source configuration.
*.sock
*.vsock
vsock
vsock_[0-9]*
*.pid
*.pid.lock
*.log
*.log.*
core
core.[0-9]*
*.core
*.dmp

# Editor/OS files and local backups.
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
.DS_Store
._*
Thumbs.db
Desktop.ini

# Multi-agent teamwork logs and coordination traces
.agents/

# Formal verification build artifacts and solver caches (Lean 4, Lake, Z3)
.lake/
*.olean
*.ilean
*.trace

# Keep config checksums, public GPG signature fixtures and dependency lockfiles.
# Deliberately no blanket rules for *.gpg, *.json, *.service, *.socket or *.lock.

